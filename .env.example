# Chép file này thành .env.local rồi điền giá trị thật.
# KHÔNG bao giờ commit giá trị thật. Xem Setup & Ops Guide §3.

# Neon connection string. Bắt buộc có ?sslmode=require — thiếu là lỗi kết nối.
# Mỗi môi trường trỏ tới một branch khác nhau: local → dev, preview → branch của
# PR, production → main.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/wwget?sslmode=require"

# openssl rand -base64 32
# Production và local KHÔNG dùng chung giá trị.
AUTH_SECRET=""

# URL gốc của môi trường đang chạy. CHỈ đặt ở local.
#
# Trên Vercel để TRỐNG: biến này ghi đè origin của mọi request, nên đặt giá trị
# production vào scope Preview sẽ làm callback trên preview trỏ nhầm domain.
# Vercel tự đặt VERCEL=1, và next-auth đọc nó để bật trustHost.
AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
